{
  "name": "teammaker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "build:api": "bun build api/index.ts --target node --format esm --packages external --outfile .tmp-api/api.mjs",
    "serve:api": "node scripts/serve-api.mjs",
    "serve:node": "bun run scripts/serve-node.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test"
  },
  "dependencies": {
    "@freebuff/auth": "0.1.0",
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "hono": "^4.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "miniflare": "5.20261110.0-beta",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
