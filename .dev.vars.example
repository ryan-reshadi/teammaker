# Local development only. Copy to .dev.vars (gitignored).
#
# Start the service with `bun run ocr:serve`: it runs the `ocr/.venv`
# interpreter, which is the only one with PaddleOCR, and fails with the exact
# install commands if that virtualenv is missing.
#
#   OCR_SERVICE_TOKEN="<same value as below>" bun run ocr:serve
#
# Then restart `bun run dev`: Vite reads this file once, at startup, so editing
# it while the dev server runs changes nothing.
#
# A deployment replaces both values with the public container's URL and token;
# a loopback URL only works for a Worker running on this machine.
OCR_SERVICE_URL="http://127.0.0.1:8000"
OCR_SERVICE_TOKEN="replace-with-a-long-random-string"
